{
    "title": "Chart Values",
    "type": "object",
    "properties": {
        "debug": {
            "type": "boolean",
            "description": "Starts the containers in idle bash mode and turns off the probes",
            "default": false
        },
        "prefix": {
            "type": "string",
            "description": "Prefix identifier for the node, deployment, ingress, or other resources",
            "default": "voi-i-1-"
        },
        "nodeName": {
            "type": "string",
            "description": "Hostname of the node the optional hostPath persistent volumes are bound to",
            "default": ""
        },
        "imagePullSecrets": {
            "type": "array",
            "description": "Image pull secrets applied to all pods",
            "default": [],
            "items": {}
        },
        "nodeSelector": {
            "type": "object",
            "description": "Node selector applied to all pods",
            "default": {}
        },
        "tolerations": {
            "type": "array",
            "description": "Tolerations applied to all pods",
            "default": [],
            "items": {}
        },
        "affinity": {
            "type": "object",
            "description": "Affinity applied to all pods",
            "default": {}
        },
        "initContainer": {
            "type": "object",
            "properties": {
                "image": {
                    "type": "string",
                    "description": "Image of the init container (needs sh and nc)",
                    "default": "busybox"
                },
                "tag": {
                    "type": "string",
                    "description": "Tag of the init container image",
                    "default": "1.37"
                },
                "imagePullPolicy": {
                    "type": "string",
                    "description": "Image pull policy of the init container",
                    "default": "IfNotPresent"
                }
            }
        },
        "db": {
            "type": "object",
            "properties": {
                "user": {
                    "type": "string",
                    "description": "Database user",
                    "default": "dbuser"
                },
                "password": {
                    "type": "string",
                    "description": "Database password",
                    "default": "postgresPassword"
                },
                "dbName": {
                    "type": "string",
                    "description": "Database name",
                    "default": "indexerdb"
                }
            }
        },
        "secretIndexer": {
            "type": "object",
            "properties": {
                "name": {
                    "type": "string",
                    "description": "Name of the secret",
                    "default": "indexer-secret"
                },
                "algodToken": {
                    "type": "string",
                    "description": "Algod token",
                    "default": "aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa"
                },
                "indexerToken": {
                    "type": "string",
                    "description": "Indexer token",
                    "default": "aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa"
                }
            }
        },
        "secretConduit": {
            "type": "object",
            "properties": {
                "name": {
                    "type": "string",
                    "description": "Name of the secret",
                    "default": "conduit-secret"
                }
            }
        },
        "pvcDB": {
            "type": "object",
            "properties": {
                "name": {
                    "type": "string",
                    "description": "Name of the PVC",
                    "default": "indexer-db-voimain-pvc"
                },
                "storageClassName": {
                    "type": "string",
                    "description": "Storage class name",
                    "default": "linode-block-storage-retain"
                },
                "accessMode": {
                    "type": "string",
                    "description": "Access mode",
                    "default": "ReadWriteOnce"
                },
                "resources": {
                    "type": "object",
                    "properties": {
                        "requests": {
                            "type": "object",
                            "properties": {
                                "storage": {
                                    "type": "string",
                                    "description": "Requested storage size",
                                    "default": "200Gi"
                                }
                            }
                        }
                    }
                }
            }
        },
        "pvDB": {
            "type": "object",
            "properties": {
                "name": {
                    "type": "string",
                    "description": "Name of the PV",
                    "default": "indexer-db-voimain-pv"
                },
                "hostPath": {
                    "type": "string",
                    "description": "Host path for the PV",
                    "default": ""
                }
            }
        },
        "deploymentDB": {
            "type": "object",
            "properties": {
                "name": {
                    "type": "string",
                    "description": "Name of the deployment",
                    "default": "indexer-voimain-db-deployment"
                },
                "label": {
                    "type": "object",
                    "properties": {
                        "key": {
                            "type": "string",
                            "description": "Label key",
                            "default": "app"
                        },
                        "value": {
                            "type": "string",
                            "description": "Label value",
                            "default": "indexer-voimain-db"
                        }
                    }
                },
                "image": {
                    "type": "string",
                    "description": "Image name",
                    "default": "postgres"
                },
                "tag": {
                    "type": "number",
                    "description": "Image tag",
                    "default": 14
                },
                "imagePullPolicy": {
                    "type": "string",
                    "description": "Image pull policy",
                    "default": "IfNotPresent"
                },
                "resources": {
                    "type": "object",
                    "properties": {
                        "requests": {
                            "type": "object",
                            "properties": {
                                "memory": {
                                    "type": "string",
                                    "description": "Requested memory",
                                    "default": "100Mi"
                                },
                                "cpu": {
                                    "type": "string",
                                    "description": "Requested CPU",
                                    "default": "100m"
                                }
                            }
                        },
                        "limits": {
                            "type": "object",
                            "properties": {
                                "memory": {
                                    "type": "string",
                                    "description": "Memory limit",
                                    "default": "16000Mi"
                                },
                                "cpu": {
                                    "type": "string",
                                    "description": "CPU limit",
                                    "default": "8000m"
                                }
                            }
                        }
                    }
                }
            }
        },
        "serviceDB": {
            "type": "object",
            "properties": {
                "name": {
                    "type": "string",
                    "description": "Name of the service",
                    "default": "indexer-voimain-db-service"
                },
                "type": {
                    "type": "string",
                    "description": "Type of the service",
                    "default": "ClusterIP"
                },
                "port": {
                    "type": "object",
                    "properties": {
                        "service": {
                            "type": "number",
                            "description": "Service port",
                            "default": 5432
                        },
                        "target": {
                            "type": "number",
                            "description": "Target port",
                            "default": 5432
                        }
                    }
                }
            }
        },
        "serviceFollowerNode": {
            "type": "object",
            "properties": {
                "name": {
                    "type": "string",
                    "description": "Name of the service",
                    "default": "indexer-voimain-follower-node-service"
                },
                "type": {
                    "type": "string",
                    "description": "Type of the service",
                    "default": "ClusterIP"
                },
                "port": {
                    "type": "object",
                    "properties": {
                        "service": {
                            "type": "number",
                            "description": "Service port",
                            "default": 8080
                        },
                        "target": {
                            "type": "number",
                            "description": "Target port",
                            "default": 8080
                        }
                    }
                }
            }
        },
        "serviceIndexer": {
            "type": "object",
            "properties": {
                "name": {
                    "type": "string",
                    "description": "Name of the service",
                    "default": "indexer-voimain-indexer-service"
                },
                "type": {
                    "type": "string",
                    "description": "Type of the service",
                    "default": "ClusterIP"
                },
                "port": {
                    "type": "object",
                    "properties": {
                        "service": {
                            "type": "number",
                            "description": "Service port",
                            "default": 8980
                        },
                        "target": {
                            "type": "number",
                            "description": "Target port",
                            "default": 8980
                        }
                    }
                }
            }
        },
        "pvcConduit": {
            "type": "object",
            "properties": {
                "name": {
                    "type": "string",
                    "description": "Name of the PVC",
                    "default": "indexer-conduit-pvc"
                },
                "storageClassName": {
                    "type": "string",
                    "description": "Storage class name",
                    "default": "linode-block-storage-retain"
                },
                "accessMode": {
                    "type": "string",
                    "description": "Access mode",
                    "default": "ReadWriteOnce"
                },
                "resources": {
                    "type": "object",
                    "properties": {
                        "requests": {
                            "type": "object",
                            "properties": {
                                "storage": {
                                    "type": "string",
                                    "description": "Requested storage size",
                                    "default": "10Gi"
                                }
                            }
                        }
                    }
                }
            }
        },
        "pvConduit": {
            "type": "object",
            "properties": {
                "name": {
                    "type": "string",
                    "description": "Name of the PV",
                    "default": "indexer-conduit-pv"
                },
                "hostPath": {
                    "type": "string",
                    "description": "Host path for the PV",
                    "default": ""
                }
            }
        },
        "pvcFollowNode": {
            "type": "object",
            "properties": {
                "name": {
                    "type": "string",
                    "description": "Name of the PVC",
                    "default": "indexer-follow-node-pvc"
                },
                "storageClassName": {
                    "type": "string",
                    "description": "Storage class name",
                    "default": "linode-block-storage-retain"
                },
                "accessMode": {
                    "type": "string",
                    "description": "Access mode",
                    "default": "ReadWriteOnce"
                },
                "resources": {
                    "type": "object",
                    "properties": {
                        "requests": {
                            "type": "object",
                            "properties": {
                                "storage": {
                                    "type": "string",
                                    "description": "Requested storage size",
                                    "default": "10Gi"
                                }
                            }
                        }
                    }
                }
            }
        },
        "pvFollowNode": {
            "type": "object",
            "properties": {
                "name": {
                    "type": "string",
                    "description": "Name of the PV",
                    "default": "indexer-follow-node-pv"
                },
                "hostPath": {
                    "type": "string",
                    "description": "Host path for the PV",
                    "default": ""
                }
            }
        },
        "deploymentFollowerNode": {
            "type": "object",
            "properties": {
                "name": {
                    "type": "string",
                    "description": "Name of the deployment",
                    "default": "indexer-voimain-follower-node-deployment"
                },
                "label": {
                    "type": "object",
                    "properties": {
                        "key": {
                            "type": "string",
                            "description": "Label key",
                            "default": "app"
                        },
                        "value": {
                            "type": "string",
                            "description": "Label value",
                            "default": "indexer-voimain-follower-node"
                        }
                    }
                },
                "image": {
                    "type": "string",
                    "description": "Image name",
                    "default": "scholtz2/voimain-follow-node"
                },
                "tag": {
                    "type": "string",
                    "description": "Image tag",
                    "default": "5.1.1-stable"
                },
                "imagePullPolicy": {
                    "type": "string",
                    "description": "Image pull policy",
                    "default": "Always"
                },
                "command": {
                    "type": "array",
                    "description": "Optional command overriding the image entrypoint",
                    "default": [
                        "/bin/bash",
                        "-ec",
                        "[ -f data/config.json ] || cp config.json data/config.json\n[ -f data/genesis.json ] || cp voimain/genesis.json data/genesis.json\ntrap 'goal node stop; exit 0' TERM INT\ngoal node start\nwhile :; do date; goal node status; sleep 600 & wait $!; done\n"
                    ],
                    "items": {
                        "type": "string"
                    }
                },
                "resources": {
                    "type": "object",
                    "properties": {
                        "requests": {
                            "type": "object",
                            "properties": {
                                "memory": {
                                    "type": "string",
                                    "description": "Requested memory",
                                    "default": "100Mi"
                                },
                                "cpu": {
                                    "type": "string",
                                    "description": "Requested CPU",
                                    "default": "100m"
                                }
                            }
                        },
                        "limits": {
                            "type": "object",
                            "properties": {
                                "memory": {
                                    "type": "string",
                                    "description": "Memory limit",
                                    "default": "6000Mi"
                                },
                                "cpu": {
                                    "type": "string",
                                    "description": "CPU limit",
                                    "default": "4000m"
                                }
                            }
                        }
                    }
                }
            }
        },
        "deploymentConduit": {
            "type": "object",
            "properties": {
                "name": {
                    "type": "string",
                    "description": "Name of the deployment",
                    "default": "indexer-voimain-conduit-deployment"
                },
                "label": {
                    "type": "object",
                    "properties": {
                        "key": {
                            "type": "string",
                            "description": "Label key",
                            "default": "app"
                        },
                        "value": {
                            "type": "string",
                            "description": "Label value",
                            "default": "indexer-voimain-conduit"
                        }
                    }
                },
                "image": {
                    "type": "string",
                    "description": "Image name",
                    "default": "algorand/conduit"
                },
                "tag": {
                    "type": "string",
                    "description": "Image tag",
                    "default": "1.11.1"
                },
                "imagePullPolicy": {
                    "type": "string",
                    "description": "Image pull policy",
                    "default": "IfNotPresent"
                },
                "mountPath": {
                    "type": "string",
                    "description": "Mount path",
                    "default": "/data"
                },
                "resources": {
                    "type": "object",
                    "properties": {
                        "requests": {
                            "type": "object",
                            "properties": {
                                "memory": {
                                    "type": "string",
                                    "description": "Requested memory",
                                    "default": "100Mi"
                                },
                                "cpu": {
                                    "type": "string",
                                    "description": "Requested CPU",
                                    "default": "100m"
                                }
                            }
                        },
                        "limits": {
                            "type": "object",
                            "properties": {
                                "memory": {
                                    "type": "string",
                                    "description": "Memory limit",
                                    "default": "6000Mi"
                                },
                                "cpu": {
                                    "type": "string",
                                    "description": "CPU limit",
                                    "default": "4000m"
                                }
                            }
                        }
                    }
                }
            }
        },
        "deploymentIndexer": {
            "type": "object",
            "properties": {
                "name": {
                    "type": "string",
                    "description": "Name of the deployment",
                    "default": "indexer-voimain-indexer-deployment"
                },
                "replicas": {
                    "type": "number",
                    "description": "Number of replicas",
                    "default": 2
                },
                "label": {
                    "type": "object",
                    "properties": {
                        "key": {
                            "type": "string",
                            "description": "Label key",
                            "default": "appId"
                        },
                        "value": {
                            "type": "string",
                            "description": "Label value",
                            "default": "indexer-voimain-indexer"
                        }
                    }
                },
                "label2": {
                    "type": "object",
                    "properties": {
                        "key": {
                            "type": "string",
                            "description": "Second label key",
                            "default": "app"
                        },
                        "value": {
                            "type": "string",
                            "description": "Second label value",
                            "default": "indexer-voimain"
                        }
                    }
                },
                "image": {
                    "type": "string",
                    "description": "Image name",
                    "default": "scholtz2/algorand-indexer"
                },
                "tag": {
                    "type": "string",
                    "description": "Image tag",
                    "default": "v3.11.1-stable"
                },
                "imagePullPolicy": {
                    "type": "string",
                    "description": "Image pull policy",
                    "default": "IfNotPresent"
                },
                "genesis": {
                    "type": "string",
                    "description": "Path to the genesis file of the chain inside the indexer image",
                    "default": "/app/genesis/voimain/genesis.json"
                },
                "resources": {
                    "type": "object",
                    "properties": {
                        "requests": {
                            "type": "object",
                            "properties": {
                                "memory": {
                                    "type": "string",
                                    "description": "Requested memory",
                                    "default": "100Mi"
                                },
                                "cpu": {
                                    "type": "string",
                                    "description": "Requested CPU",
                                    "default": "100m"
                                }
                            }
                        },
                        "limits": {
                            "type": "object",
                            "properties": {
                                "memory": {
                                    "type": "string",
                                    "description": "Memory limit",
                                    "default": "3000Mi"
                                },
                                "cpu": {
                                    "type": "string",
                                    "description": "CPU limit",
                                    "default": "3000m"
                                }
                            }
                        }
                    }
                }
            }
        },
        "ingress": {
            "type": "object",
            "properties": {
                "enabled": {
                    "type": "boolean",
                    "description": "Enable ingress",
                    "default": true
                },
                "name": {
                    "type": "string",
                    "description": "Name of the ingress",
                    "default": "indexer-voimain-ingress"
                },
                "host": {
                    "type": "string",
                    "description": "Host for the ingress",
                    "default": ""
                },
                "clusterIssuer": {
                    "type": "string",
                    "description": "Cluster issuer",
                    "default": "letsencrypt"
                },
                "ingressClassName": {
                    "type": "string",
                    "description": "Ingress class name",
                    "default": "nginx"
                },
                "annotations": {
                    "type": "object",
                    "description": "Additional ingress annotations",
                    "default": {}
                }
            }
        }
    }
